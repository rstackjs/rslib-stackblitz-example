{
  "name": "rslib-stackblitz-example",
  "version": "0.0.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "export NODE_NO_WARNINGS=1 && rslib",
    "dev": "export NODE_NO_WARNINGS=1 && rslib --watch"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.59.0",
    "@rslib/core": "1.0.0-rc.1",
    "@types/node": "^24.13.3",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "publishConfig": {
    "access": "public"
  },
  "stackblitz": {
    "startCommand": "pnpm run build"
  }
}
